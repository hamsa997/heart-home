rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * HEARTHOME SECURITY RULES (PUBLIC VERSION)
     *
     * Rules optimized for a public adoption system.
     */

    function isSignedIn() {
      return request.auth != null;
    }

    // --- Collection Rules ---

    match /pets/{petId} {
      // Anyone can browse available pets.
      allow get, list: if true;
      // In this public-only version, admin updates are disabled via rules for security.
      allow write: if false;
    }

    match /adoptionApplications/{applicationId} {
      // Anyone can submit an adoption request.
      allow create: if true;
      // In this version, viewing applications is restricted.
      allow read, update, delete: if false;
    }
    
    match /roles_admin/{userId} {
      allow read, write: if false;
    }
  }
}
