rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PETMATCH CONNECT SECURITY RULES (PROTOTYPE VERSION)
     *
     * In this version, we prioritize ease of use for development by allowing
     * any authenticated user to perform administrative actions.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    /** 
     * For prototyping, we treat any signed-in user as an admin. 
     * In production, this would check a 'roles_admin' collection.
     */
    function isAdmin() {
      return isSignedIn();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collection Rules ---

    match /roles_admin/{userId} {
      allow get, list, write: if isAdmin();
    }

    match /pets/{petId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /adoptionApplications/{applicationId} {
      // Allow authenticated users to see and manage applications.
      allow list, get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.applicantUid == request.auth.uid;
      allow update, delete: if isAdmin() || (resource != null && resource.data.applicantUid == request.auth.uid);
    }
  }
}